# Salin file ini menjadi .env dan isi nilainya

# Database (SQLite untuk development)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="ganti"
JWT_EXPIRES_IN="7d"

# Groq API (AI layer - function calling / tool use)
# Dapatkan API key gratis di https://console.groq.com/keys
GROQ_API_KEY="ganti_dengan_api_key_groq_kamu"
# Model teks untuk parsing chat -> instruksi terstruktur (mendukung tool use)
GROQ_MODEL_TEXT="llama-3.3-70b-versatile"
# Model vision untuk ekstraksi dari foto daftar produk
GROQ_MODEL_VISION="llama-4-scout-17b-16e-instruct"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"
